task.wait(0.5)
for _, container in pairs(tab:GetChildren()) do
	pcall(function()
		if container:IsA("ScrollingFrame") then
			container.ScrollingDirection = Enum.ScrollingDirection.Y
			container.ScrollBarThickness = 4
			container.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
			container.ScrollBarImageTransparency = 0.7
			container.AutomaticCanvasSize = Enum.AutomaticSize.Y
			container.ElasticBehavior = Enum.ElasticBehavior.Always
			container.ScrollingEnabled = true
			container.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseWheel then
					local newPos = container.CanvasPosition.Y - input.Position.Z * 40
					container.CanvasPosition = Vector2.new(0, math.clamp(newPos, 0, math.max(0, container.CanvasSize.Y.Offset - container.AbsoluteSize.Y)))
				end
			end)
		end
		for _, child in pairs(container:GetChildren()) do
			pcall(function()
				if child:IsA("ScrollingFrame") then
					child.ScrollingDirection = Enum.ScrollingDirection.Y
					child.ScrollBarThickness = 4
					child.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
					child.ScrollBarImageTransparency = 0.7
					child.AutomaticCanvasSize = Enum.AutomaticSize.Y
					child.ElasticBehavior = Enum.ElasticBehavior.Always
					child.ScrollingEnabled = true
					child.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseWheel then
							local newPos = child.CanvasPosition.Y - input.Position.Z * 40
							child.CanvasPosition = Vector2.new(0, math.clamp(newPos, 0, math.max(0, child.CanvasSize.Y.Offset - child.AbsoluteSize.Y)))
						end
					end)
				end
			end)
		end
	end)
