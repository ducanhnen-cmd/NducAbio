local function refreshAllESP()
	for plr in pairs(ESPObjects) do removeESP(plr) end
	if not ESPEnabled then return end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			if espIgnoreTeam and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
				continue
			end
			createESP(plr)
		end
	end
end

-- ==================== HITBOX ====================
local function CreateHitbox(player)
	if player == LocalPlayer then return end
	
	local function setupHitbox(character)
		if not character then return end
		
		if HitboxObjects[player] then
			for _, obj in pairs(HitboxObjects[player]) do
				if obj then obj:Destroy() end
			end
		end
		HitboxObjects[player] = {}
		
		local head = character:WaitForChild("Head", 5)
		if head then
			local hitbox = Instance.new("Part")
			hitbox.Name = "HitboxExpander_Head"
			hitbox.Transparency = 0.5
			hitbox.BrickColor = BrickColor.new("Bright red")
			hitbox.Material = Enum.Material.Neon
			hitbox.CanCollide = false
			hitbox.CanQuery = false
			hitbox.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
			hitbox.Massless = true
			hitbox.Parent = character
			
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = hitbox
			weld.Part1 = head
			weld.Parent = hitbox
			HitboxObjects[player].HeadHitbox = hitbox
		end
		
		local hrp = character:WaitForChild("HumanoidRootPart", 5)
		if hrp then
			local bodyHitbox = Instance.new("Part")
			bodyHitbox.Name = "HitboxExpander_Body"
			bodyHitbox.Transparency = 0.5
			bodyHitbox.BrickColor = BrickColor.new("Bright red")
			bodyHitbox.Material = Enum.Material.Neon
			bodyHitbox.CanCollide = false
			bodyHitbox.CanQuery = false
			bodyHitbox.Size = Vector3.new(HitboxSize, HitboxSize * 1.5, HitboxSize)
			bodyHitbox.Massless = true
			bodyHitbox.Parent = character
			
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = bodyHitbox
			weld.Part1 = hrp
			weld.Parent = bodyHitbox
			HitboxObjects[player].BodyHitbox = bodyHitbox
		end
	end
	
	if player.Character then
		setupHitbox(player.Character)
	end
	
	player.CharacterAdded:Connect(function(character)
		if HitboxEnabled then
			task.wait(0.3)
			setupHitbox(character)
		end
	end)
end

local function ToggleHitbox(state)
	HitboxEnabled = state
	if state then
		for _, player in pairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				CreateHitbox(player)
			end
		end
	else
		for player, objects in pairs(HitboxObjects) do
			for _, obj in pairs(objects) do
				if obj then obj:Destroy() end
			end
		end
		HitboxObjects = {}
	end
end

