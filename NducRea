-- ==================== MAIN LOOP ====================
RunService.RenderStepped:Connect(function()
	local localChar = LocalPlayer.Character
	local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
	
	-- FOV Circle
	if AimbotEnabled then
		local mouse = UserInputService:GetMouseLocation()
		fovCircle.Position = UDim2.new(0, mouse.X, 0, mouse.Y)
		fovCircle.Size = UDim2.new(0, aimbotFov * 2, 0, aimbotFov * 2)
		fovStroke.Color = aimColor
		fovCircle.Visible = true
	else
		fovCircle.Visible = false
	end
	
	-- ESP Update
	for plr, data in pairs(ESPObjects) do
		if not plr.Character or not data.hrp or not data.hrp.Parent or not data.char or not data.char.Parent then
			removeESP(plr)
			continue
		end
		
		local withinRange = true
		if localHrp and data.hrp then
			local d3 = (data.hrp.Position - localHrp.Position).Magnitude
			if d3 > ESP_MAX_DISTANCE then withinRange = false end
		end
		
		data.nameLabel.Visible = showNames and ESPEnabled and withinRange
		data.healthBg.Visible = showHealth and ESPEnabled and withinRange
		data.distLabel.Visible = showDistance and ESPEnabled and withinRange
		
		if data.highlight and data.highlight.Parent then
			data.highlight.Enabled = showBox and ESPEnabled and withinRange
			data.highlight.FillColor = espColor
			data.highlight.OutlineColor = espColor
		end
		
		if data.lineEsp then
			for _, line in pairs(data.lineEsp) do
				if line and line.Parent then
					line.Visible = showBoxESP and ESPEnabled
					line.Color3 = espColor
				end
			end
		end
		
		if data.tracerBeam and data.tracerBeam.Parent then
			data.tracerBeam.Enabled = showLines and ESPEnabled and withinRange
			data.tracerBeam.Color = ColorSequence.new(espColor)
			if localHrp and data.tracerAttachment1 then
				data.tracerAttachment1.Parent = localHrp
			end
		end
		
		if data.fovCircleGui and data.fovCircleGui.Parent then
			local head = plr.Character and plr.Character:FindFirstChild("Head")
			if head then
				local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
				if onScreen and withinRange then
					local mousePos = UserInputService:GetMouseLocation()
					local screenVec = Vector2.new(screenPos.X, screenPos.Y)
					local dist2d = (screenVec - mousePos).Magnitude
					local inFov = dist2d <= aimbotFov
					data.fovCircleGui.Visible = showFovCircle and ESPEnabled and inFov
					if data.fovCircleGui.Visible then
						local circleSize = 60
						if localHrp and data.hrp then
							local worldDist = (data.hrp.Position - localHrp.Position).Magnitude
							local scale = math.clamp(200 / worldDist, 0.3, 1.5)
							circleSize = 60 * scale
						end
						data.fovCircleGui.Size = UDim2.new(0, circleSize, 0, circleSize)
						data.fovCircleGui.Position = UDim2.new(0, screenPos.X - circleSize/2, 0, screenPos.Y - circleSize/2)
						if data.fovCircleStroke then
							data.fovCircleStroke.Color = espColor
						end
					end
				else
					data.fovCircleGui.Visible = false
				end
			end
		end
		
		if not ESPEnabled then continue end
		data.nameLabel.Text = plr.DisplayName
		data.nameLabel.TextColor3 = espColor
		
		local hum = data.hum
		if hum and hum.Parent then
			local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
			data.healthBar.Size = UDim2.new(pct, 0, 1, 0)
		end
		
		if localHrp then
			local dist = math.floor((data.hrp.Position - localHrp.Position).Magnitude)
			data.distLabel.Text = dist .. " studs"
		end
	end
	
	-- Aimbot
	if not AimbotEnabled then return end
	local rmbHeld = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
	if not rmbHeld and not autoAimEnabled then return end
	
	local mousePos = UserInputService:GetMouseLocation()
	local bestPlayer = nil
	local bestDist = math.huge
	
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr == LocalPlayer then continue end
		if aimIgnoreTeam and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then continue end
		
		local char = plr.Character
		if not char then continue end
		local head = char:FindFirstChild("Head")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not head or not hum or hum.Health <= 0 then continue end
		
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local worldDist = (hrp and localHrp) and (hrp.Position - localHrp.Position).Magnitude or math.huge
		if worldDist > aimbotMaxDist then continue end
		
		local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
		local dist2d
		if onScreen then
			local screenVec = Vector2.new(screenPos.X, screenPos.Y)
			dist2d = (screenVec - mousePos).Magnitude
		elseif autoAimEnabled then
			dist2d = aimbotFov
		else
			continue
		end
		
		if dist2d < aimbotFov and worldDist < bestDist then
			bestDist = worldDist
			bestPlayer = plr
		end
	end
	
	if not bestPlayer then return end
	local char = bestPlayer.Character
	if not char then return end
	local head = char:FindFirstChild("Head")
	if not head then return end
	
	local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
	if not onScreen and autoAimEnabled then
		screenPos = Camera:WorldToViewportPoint(head.Position)
	end
	
	local current = UserInputService:GetMouseLocation()
	local goal = Vector2.new(screenPos.X, screenPos.Y)
	local lerpAlpha = 1 - (math.clamp(aimbotSmooth, 0, 0.9) * 0.9)
	local delta = (goal - current) * lerpAlpha
	mousemoverel(delta.X, delta.Y)
end)

