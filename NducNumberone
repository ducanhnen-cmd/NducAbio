-- ==================== INSTANT KILL FUNCTIONS ====================
local function isTargetAlive(model)
    return model and model:FindFirstChild("HumanoidRootPart")
        and model:FindFirstChild("Humanoid")
        and model.Humanoid.Health > 0
end

local function resetCamera()
    Camera.CameraType = Enum.CameraType.Custom
end

local function followTarget(model)
    if followConnection then followConnection:Disconnect() end
    currentTarget = model
    Camera.CameraType = Enum.CameraType.Scriptable
    
    followConnection = RunService.Heartbeat:Connect(function()
        if not instantKillEnabled 
           or not isTargetAlive(model)
           or isInLobby(LocalPlayer.Character)
           or isInLobby(model) then
            
            if followConnection then followConnection:Disconnect() end
            followConnection = nil
            currentTarget = nil
            resetCamera()
            return
        end
        
        local Character = LocalPlayer.Character
        if not Character then return end
        
        local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
        if not HumanoidRootPart then return end
        
        local targetHRP = model.HumanoidRootPart
        local targetHead = model:FindFirstChild("Head")
        local myHead = Character:FindFirstChild("Head")
        
        -- Noclip
        HumanoidRootPart.CanCollide = false
        
        -- Position behind target
        local targetPos = targetHRP.Position
        local lookVector = targetHRP.CFrame.LookVector
        local myPos = targetPos + Vector3.new(0, HEIGHT_OFFSET, 0) - (lookVector * INSTANT_KILL_DISTANCE)
        
        HumanoidRootPart.CFrame = CFrame.lookAt(myPos, targetPos)
        
        -- Camera lock on head
        local myEyePos = myHead and myHead.Position or (HumanoidRootPart.Position + Vector3.new(0, 2, 0))
        local targetLookPos = targetHead and targetHead.Position or (targetPos + Vector3.new(0, 1.5, 0))
        Camera.CFrame = CFrame.lookAt(myEyePos, targetLookPos)
    end)
end

-- Respawn handler
LocalPlayer.CharacterAdded:Connect(function(newChar)
    task.wait(0.5)
    resetCamera()
    if instantKillEnabled and currentTarget and isTargetAlive(currentTarget) then
        followTarget(currentTarget)
    end
end)

-- Main cycling loop for Instant Kill
spawn(function()
    while true do
        task.wait(0.1)
        
        if not instantKillEnabled then
            if followConnection then followConnection:Disconnect() end
            followConnection = nil
            currentTarget = nil
            resetCamera()
            continue
        end
        
        if #allTargets == 0 then
            resetCamera()
            continue
        end
        
        local found = false
        for i = 1, #allTargets do
            local index = (currentIndex + i - 2) % #allTargets + 1
            local model = allTargets[index]
            
            if isTargetAlive(model) and not isInLobby(model) then
                followTarget(model)
                currentIndex = index
                found = true
                break
            end
        end
        
        if found then
            repeat
                task.wait(0.1)
            until not instantKillEnabled or not isTargetAlive(currentTarget) or isInLobby(currentTarget)
            
            if followConnection then followConnection:Disconnect() end
            followConnection = nil
            currentTarget = nil
            resetCamera()
        else
            resetCamera()
        end
    end
end)

-- ==================== ESP FUNCTIONS ====================
local function removeESP(plr)
    local d = ESPObjects[plr]
    if not d then return end
    if d.bill and d.bill.Parent then d.bill:Destroy() end
    if d.lineEsp then
        for _, line in pairs(d.lineEsp) do
            if line and line.Parent then line:Destroy() end
        end
    end
    if d.tracerBeam and d.tracerBeam.Parent then d.tracerBeam:Destroy() end
    if d.tracerAttachment0 and d.tracerAttachment0.Parent then d.tracerAttachment0:Destroy() end
    if d.tracerAttachment1 and d.tracerAttachment1.Parent then d.tracerAttachment1:Destroy() end
    if d.fovCircleGui and d.fovCircleGui.Parent then d.fovCircleGui:Destroy() end
    ESPObjects[plr] = nil
end

